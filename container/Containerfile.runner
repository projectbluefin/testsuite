# Test runner image for projectbluefin/testsuite
#
# Published to: ghcr.io/projectbluefin/testsuite:runner
#
# Used by .github/workflows/e2e.yml to avoid slow pip installs inside the QEMU VM.
# The ubuntu runner pulls this image while the VM is booting, then pipes it into
# the VM via `podman save | ssh podman load`. Tests run inside this container with
# the host GNOME session's D-Bus/AT-SPI sockets mounted.
#
# Required mounts when running:
#   -v /run/user/1001:/run/user/1001       (Wayland + D-Bus sockets)
#   -v /dev/uinput:/dev/uinput             (input injection)
#   -v /tmp/bluefin-tests:/tests:ro        (test files)
#   -v /tmp/results:/tmp/results           (results output)
#   --network host                         (AT-SPI D-Bus traffic)
#
# Required env vars:
#   DBUS_SESSION_BUS_ADDRESS
#   WAYLAND_DISPLAY
#   XDG_RUNTIME_DIR=/run/user/1001
#
# Required podman flags when running inside the QEMU VM:
#   --pid=host          (qecore reads GNOME session env from /proc/<pid>/environ)
#   --privileged        (uinput + AT-SPI socket access)

FROM registry.fedoraproject.org/fedora-minimal:latest@sha256:1f4d147e7787705a2a93d74de0772aef86866d19c1b40982573c23bede20fce2

LABEL org.opencontainers.image.source="https://github.com/projectbluefin/testsuite"
LABEL org.opencontainers.image.description="qecore/behave/dogtail test runner for GNOME e2e tests"

RUN microdnf install -y --setopt=install_weak_deps=0 \
        python3 \
        python3-pip \
        python3-gobject \
        python3-dbus \
        gobject-introspection \
        at-spi2-core \
        at-spi2-atk \
        atk \
        dbus-glib \
        dbus-tools \
        gtk3 \
        gsettings-desktop-schemas \
        dbus-libs \
        glib2 \
        curl \
        util-linux-core \
        openssh-clients \
        procps-ng \
    && microdnf clean all

# Generate a stable machine-id so D-Bus (and ponytail) work inside the container.
# Fedora-minimal ships /etc/machine-id as an empty file; dbus-uuidgen fills it.
# Also symlink /var/lib/dbus/machine-id which some D-Bus implementations expect.
RUN dbus-uuidgen > /etc/machine-id && \
    mkdir -p /var/lib/dbus && \
    ln -sf /etc/machine-id /var/lib/dbus/machine-id

# dbus-run-session was removed from dbus-tools in dbus 1.16 (Fedora 44+).
# qecore-headless still calls it to check/set toolkit-accessibility inside the
# container.  The container already has DBUS_SESSION_BUS_ADDRESS injected via
# the `podman run -e` flags, so a pass-through shim is sufficient.
RUN printf '#!/bin/sh\nexec "$@"\n' > /usr/local/bin/dbus-run-session && \
    chmod +x /usr/local/bin/dbus-run-session

# Install Python test stack — pinned so bumps are explicit and reviewed
# Pinned 2026-05-30 — bump manually or via Renovate
# python-uinput is a C extension and requires gcc + python3-devel to build from source;
# remove build tools afterwards to keep the image lean.
# setuptools provides pkg_resources (used by qecore sandbox._attach_version_status_to_report).
# setuptools 81 removed pkg_resources; pin to <81 to avoid ImportError noise in logs.
RUN microdnf install -y --setopt=install_weak_deps=0 gcc python3-devel \
    && python3 -m pip install --no-cache-dir \
        qecore==4.16 \
        behave==1.3.3 \
        dogtail==2.0.3 \
        python-uinput==1.0.1 \
        "setuptools<81" \
    && python3 -m pip cache purge \
    && microdnf remove -y gcc python3-devel \
    && microdnf clean all

# Install the pure-Python ponytail module (qecore imports it for input events via
# gnome-ponytail-daemon). Not on PyPI — downloaded directly from the tagged release.
ARG PONYTAIL_VERSION=0.0.11
RUN PDIR="$(python3 -c 'import site; print(site.getsitepackages()[0])')/ponytail" && \
    mkdir -p "$PDIR" && \
    curl -sSfL "https://gitlab.gnome.org/ofourdan/gnome-ponytail-daemon/-/raw/${PONYTAIL_VERSION}/ponytail/__init__.py" \
         -o "$PDIR/__init__.py" && \
    curl -sSfL "https://gitlab.gnome.org/ofourdan/gnome-ponytail-daemon/-/raw/${PONYTAIL_VERSION}/ponytail/ponytail.py" \
         -o "$PDIR/ponytail.py"

# Symlink qecore helpers onto PATH
RUN for f in /usr/local/bin/qecore_*; do \
        [ -f "$f" ] && ln -sf "$f" "/usr/bin/$(basename "$f")"; \
    done; \
    ln -sf /usr/local/bin/qecore-headless /usr/bin/qecore-headless 2>/dev/null || true

# qecore-headless calls `sudo stat` to check dconf file ownership and `sudo mv`
# to configure gnome-shell's systemd service.  Neither `sudo` nor a sudoers
# config exists in this Fedora-minimal image.  A passthrough shim that runs
# commands directly (without privilege escalation) lets the ownership check
# succeed: stat returns the real UID/GID, "root" is never in the output, so
# qecore-headless skips the dconf-reset path and writes no fatal headless errors.
# All other sudo calls (mv/rm of gnome-shell service configs) are no-ops because
# gnome-shell is not installed in the container.
#
# The shim must strip sudo flags (-H, -u user, -n, -E, etc.) that qecore passes
# before exec-ing the real command.  Shell's exec builtin rejects unknown flags.
RUN python3 - <<'SUDOEOF'
# Write a Python sudo shim that handles all flag styles:
#   -H (no value), -u user (value), -Hu user (combined), -n, etc.
shim = r"""#!/usr/bin/env python3
import sys, os
VALUE_FLAGS = set('ugCrTpc')
args = sys.argv[1:]
i = 0
while i < len(args):
    a = args[i]
    if a == '--':
        i += 1
        break
    if not a.startswith('-'):
        break
    flags = a[1:]
    if any(c in VALUE_FLAGS for c in flags):
        i += 2
    else:
        i += 1
if i >= len(args):
    sys.exit(0)
os.execvp(args[i], args[i:])
"""
with open('/usr/local/bin/sudo', 'w') as f:
    f.write(shim)
import os, stat
os.chmod('/usr/local/bin/sudo', stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP | stat.S_IROTH | stat.S_IXOTH)
SUDOEOF
RUN ln -sf /usr/local/bin/sudo /usr/bin/sudo

# Patch qecore-headless for container-in-VM operation:
#
# 1. ALL recoverable=False calls: the container runs with --userns=keep-id and
#    lacks a live GNOME session, so many qecore-headless checks legitimately fail
#    (pgrep gnome-session, /proc/<pid>/environ reads, sudo stat on dconf).  Any
#    fail_and_propagate=True entry in /tmp/qecore_headless_data.json causes
#    TestSandbox to call sys.exit(1) in before_scenario for every scenario, making
#    the entire suite show 0 passed / 0 failed / N skipped.  Make all print_fail
#    calls recoverable so headless errors become warnings, not fatal terminations.
#
# 2. XDG_SESSION_TYPE / XDG_SESSION_DESKTOP are passed via `podman run -e` but
#    qecore-headless overwrites os.environ from /proc/<pid>/environ and only
#    preserves a fixed allowlist (ENVIRONMENT_VARIABLES_TO_PRESERVE).  Add both
#    vars to that list so they survive the env reset even when proc read fails.
RUN python3 - <<'PYEOF'
import re

with open('/usr/local/bin/qecore-headless', 'r') as f:
    src = f.read()

# 1. Make ALL print_fail calls recoverable (remove recoverable=False everywhere)
src = re.sub(r',\s*recoverable\s*=\s*False', '', src)

# 2. Add XDG session vars AND D-Bus/AT-SPI addresses to the preserve list
#    so they survive the os.environ reset on the normal (proc-read-succeeds) path.
src = src.replace(
    'ENVIRONMENT_VARIABLES_TO_PRESERVE = [',
    'ENVIRONMENT_VARIABLES_TO_PRESERVE = [\n    "XDG_SESSION_TYPE",\n    "XDG_SESSION_DESKTOP",\n    "DBUS_SESSION_BUS_ADDRESS",\n    "AT_SPI_BUS_ADDRESS",\n    "WAYLAND_DISPLAY",\n    "XDG_RUNTIME_DIR",',
)

# 3. Bypass root-user exit: the Fedora-minimal image has no USER directive so
#    os.geteuid() == 0 inside the container, firing the "not meant to be run
#    under root" branch and calling exit_headless_or_propagate_error(sys.exit(1)).
#    Patch 1 removes recoverable=False from print_fail but the exit call still
#    fires.  Short-circuit the entire elif branch so headless continues normally.
src = src.replace(
    'elif os.geteuid() == 0 and not self.no_automatic_login:',
    'elif False:  # patched: container runs as root but is isolated inside QEMU/GHA',
)

# 4. Handle images (e.g. bluefin:lts / RHEL10) where gnome-session is managed
#    by the GDM user (UID 65534) rather than the autologin user UID.
#    When pgrep with user-id filter finds nothing, retry without the filter.
#    If still nothing, fall back to the existing os.environ (already populated
#    from session.env via podman -e flags) so tests can proceed.
old_pgrep = (
    '    try:\n'
    '        gnome_session_pid = run(f"pgrep {user_id_grep} gnome-session").split("\\n")[0]\n'
    '    except CalledProcessError:\n'
    '        if verbose:\n'
    '            print_fail("Failed to retrieve gnome-session-binary pid from pgrep:")\n'
    '            print_fail(f"\\n{traceback.format_exc()}")'
)
new_pgrep = (
    '    try:\n'
    '        gnome_session_pid = run(f"pgrep {user_id_grep} gnome-session").split("\\n")[0]\n'
    '    except CalledProcessError:\n'
    '        # Fallback: try without UID filter (images where gnome-session runs as a different UID)\n'
    '        try:\n'
    '            gnome_session_pid = run("pgrep gnome-session").split("\\n")[0]\n'
    '        except CalledProcessError:\n'
    '            gnome_session_pid = None\n'
    '        if not gnome_session_pid and verbose:\n'
    '            print_fail("Failed to retrieve gnome-session-binary pid from pgrep:")\n'
    '            print_fail(f"\\n{traceback.format_exc()}")'
)
if old_pgrep in src:
    src = src.replace(old_pgrep, new_pgrep)
else:
    print("WARNING: Patch 4 pgrep target not found — skipping")

# 4b. When no gnome-session PID found at all, use existing os.environ as fallback
#     instead of returning an empty dict (which leaves headless with no session env).
old_fallback = (
    '    if verbose:\n'
    '        print_fail("Environment file not found, most likely caused by gdm not running.")\n'
    '\n'
    '    return environment_dictionary'
)
new_fallback = (
    '    if verbose:\n'
    '        print_fail("Environment file not found — using container environment as fallback.")\n'
    '    # Copy session-critical vars from container env (populated via podman -e flags)\n'
    '    for key in ("DBUS_SESSION_BUS_ADDRESS", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR",\n'
    '                "AT_SPI_BUS_ADDRESS", "XAUTHORITY", "XDG_SESSION_TYPE", "XDG_SESSION_DESKTOP"):\n'
    '        if key in os.environ:\n'
    '            environment_dictionary[key] = os.environ[key]\n'
    '\n'
    '    return environment_dictionary'
)
if old_fallback in src:
    src = src.replace(old_fallback, new_fallback)
else:
    print("WARNING: Patch 4b fallback target not found — skipping")

# 5. Wrap stop_display_manager() in a try/except so CalledProcessError from
#    "sudo systemctl stop gdm" (which fails inside a container that has no
#    systemd PID 1) does not propagate as an unhandled exception and cause
#    Python to exit 1, masking a successful test run (user_script_exit_code=0).
old_stop = (
    '        # Stop display manager unless user specifies otherwise.\n'
    '        if self.enable_stop or self.user_script_exit_code != 0:\n'
    '            self.display_manager_control.stop_display_manager()'
)
new_stop = (
    '        # Stop display manager unless user specifies otherwise.\n'
    '        # Wrap in try/except: inside a container (no systemd PID 1) the\n'
    '        # "sudo systemctl stop gdm" call raises CalledProcessError which\n'
    '        # would propagate as an unhandled exception and exit Python with 1,\n'
    '        # hiding a successful test run (user_script_exit_code=0).\n'
    '        if self.enable_stop or self.user_script_exit_code != 0:\n'
    '            try:\n'
    '                self.display_manager_control.stop_display_manager()\n'
    '            except Exception as _gdm_stop_exc:  # noqa: BLE001\n'
    '                print(f"headless: GDM stop warning (non-fatal in container): {_gdm_stop_exc}", flush=True)'
)
if old_stop in src:
    src = src.replace(old_stop, new_stop)
else:
    print("WARNING: Patch 5 stop_display_manager target not found — skipping")

# 6. Patch get_environment_dictionary() failure path to not call sys.exit(1),
#    AND populate environment_dictionary from the container's os.environ so that
#    DBUS_SESSION_BUS_ADDRESS / AT_SPI_BUS_ADDRESS (injected via podman -e flags
#    in e2e.yml) are not wiped when qecore-headless resets os.environ from an
#    empty dict.  Without this, images where gnome-session runs as a different UID
#    (e.g. dakota) hit "AT-SPI: Couldn't connect" (exit 250) even though the
#    session bus address was correctly queried and passed via -e.
old_env_exit = (
    '            print_fail("Attempt to retrieve environmental variables failed.")\n'
    '            self.display_manager_control.stop_display_manager()\n'
    '\n'
    '            exit_headless_or_propagate_error(propagate_to_sandbox=self.propagate_to_sandbox)'
)
new_env_exit = (
    '            print_fail("Attempt to retrieve environmental variables failed.")\n'
    '            # Patched: do NOT stop GDM or exit here.  Container os.environ already has\n'
    '            # required session vars from podman -e flags (e2e.yml).  Continue instead.\n'
    '            print_info("WARNING: env retrieval failed — continuing with container os.environ")'
)
if old_env_exit in src:
    src = src.replace(old_env_exit, new_env_exit)
    print("Patch 6 applied: env retrieval failure copies container env instead of exiting")
else:
    print("WARNING: Patch 6 env_exit target not found — skipping")

# 8. When /proc/<pid>/environ is unreadable (IOError/PermissionError — e.g. because
#    the process runs as a different UID), environment_dictionary is left empty and
#    the ENVIRONMENT_VARIABLES_TO_PRESERVE loop only copies ~7 vars.
#    qecore-headless then does os.environ = environment_dictionary, wiping PATH, HOME,
#    DISPLAY, and everything else the test toolchain needs — even though
#    DBUS_SESSION_BUS_ADDRESS was preserved.
#    Fix: on IOError, seed environment_dictionary from the full container os.environ so
#    the session env is complete.  setdefault() lets any gnome-session vars (if
#    partially read before the IOError) take priority over container defaults.
old_ioerror = (
    '        except IOError as error:\n'
    '            if verbose:\n'
    '                print_fail(f"Environment file manipulation failed on: \'{error}\'")\n'
)
new_ioerror = (
    '        except IOError as error:\n'
    '            if verbose:\n'
    '                print_fail(f"Environment file manipulation failed on: \'{error}\'")\n'
    '            # /proc environ unreadable (different UID) — seed dict from container env\n'
    '            for _k, _v in os.environ.items():\n'
    '                environment_dictionary.setdefault(_k, _v)\n'
)
if old_ioerror in src:
    src = src.replace(old_ioerror, new_ioerror)
    print("Patch 8 applied: IOError path seeds environment_dictionary from container os.environ")
else:
    print("WARNING: Patch 8 IOError target not found — skipping")

with open('/usr/local/bin/qecore-headless', 'w') as f:
    f.write(src)
PYEOF

# Patch qecore sandbox.py: prevent context.headless_errors assignment so
# headless startup errors don't cause sys.exit(1) in before_scenario.
RUN python3 - <<'SANDBOXEOF'
import re, site, os

for p in site.getsitepackages():
    path = os.path.join(p, 'qecore', 'sandbox.py')
    if not os.path.exists(path):
        continue
    with open(path) as f:
        src = f.read()
    src = src.replace(
        'context.headless_errors = headless_errors',
        'pass  # patched: headless errors non-fatal in container',
    )
    with open(path, 'w') as f:
        f.write(src)
    print(f"Patched {path}")
    break
SANDBOXEOF

# Patch dogtail ponytail_helper for container operation (no gnome-ponytail-daemon):
# 1. get_ponytail_interface(): return None instead of raising RuntimeError
# 2. get_window_id(): return None when ponytail_interface is None (avoids AttributeError)
# This prevents sandbox.before_scenario's overview_action("hide") from hook_erroring
# every scenario via the click() → window_id → ponytail chain.
RUN python3 - <<'PONYTAILEOF'
import site, os, re

for p in site.getsitepackages():
    path = os.path.join(p, 'dogtail', 'ponytail_helper.py')
    if not os.path.exists(path):
        continue
    with open(path) as f:
        src = f.read()

    # Patch 1: get_ponytail_interface returns None instead of raising
    src = src.replace(
        'raise RuntimeError(self.error_message)',
        'print(f"WARNING: ponytail unavailable: {self.error_message}", flush=True); return None',
    )

    # Patch 2: get_window_id returns None when ponytail_interface is None
    # Insert a None-guard right after the get_ponytail_interface() call
    src = re.sub(
        r'(ponytail_interface\s*=\s*self\.get_ponytail_interface\(\))',
        r'\1\n        if ponytail_interface is None:\n            return None',
        src,
    )

    with open(path, 'w') as f:
        f.write(src)
    print(f"Patched {path}")
    break
PONYTAILEOF

# Patch 7: Guard rawinput.py Wayland paths against None ponytail_interface.
# rawinput.click/point/double_click/press/release all call
# ponytail_helper.get_ponytail_interface() and immediately access .window_list
# or .generateButtonEvent without any None guard.  When the ponytail daemon is
# unavailable, get_ponytail_interface() returns None (Patch 1 above) and the
# next line crashes with:
#   AttributeError: 'NoneType' object has no attribute 'window_list'
# which propagates as a HOOK-ERROR in before_scenario and prevents ALL
# scenarios from running in any suite that uses click().
# Fix: insert "if ponytail_interface is None: return" after every
# "ponytail_interface = ponytail_helper.get_ponytail_interface()" in rawinput.py.
RUN python3 - <<'RAWINPUTEOF'
import site, os, re

for p in site.getsitepackages():
    path = os.path.join(p, 'dogtail', 'rawinput.py')
    if not os.path.exists(path):
        continue
    with open(path) as f:
        src = f.read()

    patched = re.sub(
        r'(ponytail_interface\s*=\s*ponytail_helper\.get_ponytail_interface\(\))',
        r'\1\n        if ponytail_interface is None:\n            return',
        src,
    )

    if patched == src:
        print("WARNING: Patch 7 rawinput target not found — skipping")
    else:
        with open(path, 'w') as f:
            f.write(patched)
        count = patched.count("if ponytail_interface is None:\n            return")
        print(f"Patch 7 applied: {count} None guard(s) added to rawinput.py")
    break
RAWINPUTEOF

# Create dummy desktop files so qecore's get_application() desktop-file lookup
# succeeds in the container (which lacks /usr/share/applications/).
# The files only need [Desktop Entry] + Name + Exec to satisfy the parser.
RUN mkdir -p /usr/share/applications && \
    printf '[Desktop Entry]\nName=Ptyxis\nExec=ptyxis\nType=Application\n' \
        > /usr/share/applications/org.gnome.Ptyxis.desktop && \
    printf '[Desktop Entry]\nName=Software\nExec=gnome-software\nType=Application\n' \
        > /usr/share/applications/org.gnome.Software.desktop

# /usr/local/bin/ptyxis — SSH-launch shim so qecore's start_via_command() works
# inside the runner container where the ptyxis binary is not installed.
# qecore reads Exec=ptyxis from the dummy .desktop file and calls Popen("ptyxis").
# This shim fires ptyxis on the GNOME session running in the VM via SSH
# (fire-and-forget), then exits 0 so qecore's wait_before_app_starts() can poll
# the AT-SPI tree until ptyxis appears (ponytail bridges AT-SPI over the network).
RUN python3 - <<'PTYXIS_SHIM_EOF'
import os, stat

shim = """#!/bin/sh
# Kill any stale instance so AT-SPI sees a fresh window
ssh \\
  -i "${SSH_KEY:-/home/bluefin-test/.ssh/id_ed25519}" \\
  -o StrictHostKeyChecking=no \\
  -o UserKnownHostsFile=/dev/null \\
  -o ConnectTimeout=10 \\
  -o LogLevel=ERROR \\
  -p "${SSH_PORT:-22}" \\
  "${VM_USER:-bluefin-test}@${VM_IP:-127.0.0.1}" \\
  'pkill -fx ptyxis 2>/dev/null; true'
# Launch ptyxis detached from the SSH session
ssh \\
  -i "${SSH_KEY:-/home/bluefin-test/.ssh/id_ed25519}" \\
  -o StrictHostKeyChecking=no \\
  -o UserKnownHostsFile=/dev/null \\
  -o ConnectTimeout=10 \\
  -o LogLevel=ERROR \\
  -p "${SSH_PORT:-22}" \\
  "${VM_USER:-bluefin-test}@${VM_IP:-127.0.0.1}" \\
  'source /tmp/session.env 2>/dev/null; nohup ptyxis </dev/null >/dev/null 2>&1 & disown'
"""

path = "/usr/local/bin/ptyxis"
with open(path, "w") as f:
    f.write(shim.lstrip())
os.chmod(path, os.stat(path).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
print(f"Ptyxis SSH-launch shim written to {path}")
PTYXIS_SHIM_EOF

# With --userns=keep-id, the container runs as UID 1001 (no passwd entry in this
# Fedora-minimal image).  GLib/gsettings falls back to WORKDIR as HOME when no
# passwd entry exists, and WORKDIR=/tests is owned by root so writes fail.
# Setting HOME=/tmp ensures GLib can create its settings keyfile backend.
ENV HOME=/tmp
WORKDIR /tmp
ENTRYPOINT ["qecore-headless"]
