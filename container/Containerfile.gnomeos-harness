# Native test overlay, never a replacement for the official base provenance.
# Both arguments must be digest references resolved by build-gnomeos-harness.sh.
ARG GNOMEOS_BASE
ARG GNOMEOS_DEVEL
FROM ${GNOMEOS_BASE} AS base
FROM ${GNOMEOS_DEVEL} AS build
COPY --from=base /usr/lib/os-release /tmp/base-os-release
RUN python3 - <<'PY'
import shlex
from pathlib import Path
def identity(path):
    return dict(line.split('=', 1) for line in shlex.split(Path(path).read_text(), comments=True))
base = identity('/tmp/base-os-release')
devel = identity('/usr/lib/os-release')
assert base['ID'] == devel['ID'] == 'org.gnome.os', 'not GNOME OS'
assert base.get('GNOMEOS_COMMIT'), 'missing base commit'
assert base['GNOMEOS_COMMIT'] == devel.get('GNOMEOS_COMMIT'), 'base/devel build mismatch; retry after publication completes'
PY
COPY ponytail.tar.gz /tmp/ponytail.tar.gz
RUN echo '9b18d267c55ec950beeea42d3291d2e77f8f7e351c31c6a48feb90dacb195fc5  /tmp/ponytail.tar.gz' | sha256sum -c - \
    && mkdir /tmp/ponytail \
    && tar -xzf /tmp/ponytail.tar.gz --strip-components=1 -C /tmp/ponytail \
    && meson setup /tmp/ponytail/build /tmp/ponytail --prefix=/usr --libexecdir=libexec \
         --wrap-mode=nofallback -Dsystemd_user_unit_dir=/usr/lib/systemd/user \
    && meson compile -C /tmp/ponytail/build \
    && DESTDIR=/out meson install -C /tmp/ponytail/build
# Build C extensions with the matching GNOME OS development headers. Native GI
# and D-Bus bindings come from GNOME OS, not from Fedora or a pip-built substitute.
RUN python3 -m venv --system-site-packages /opt/gnomeos-harness \
    && /opt/gnomeos-harness/bin/pip install --no-cache-dir \
         qecore==4.19.3 behave==1.3.3 dogtail==2.0.3 python-uinput==1.0.1 'setuptools<81' \
    && /opt/gnomeos-harness/bin/pip freeze > /opt/gnomeos-harness/packages.txt
RUN pkg-config --list-all | awk '$1 ~ /^libmutter-[0-9]+$/ {print $1}' \
    | while read -r package; do pkg-config --modversion "$package"; done \
    > /opt/gnomeos-harness/mutter-version.txt \
    && test -s /opt/gnomeos-harness/mutter-version.txt
FROM base
COPY --from=build /out/usr/ /usr/
COPY --from=build /opt/gnomeos-harness/ /opt/gnomeos-harness/
RUN /opt/gnomeos-harness/bin/python -c 'import gi, dbus, ponytail.ponytail, uinput, qecore, behave, dogtail' \
    && ldd /usr/libexec/gnome-ponytail-daemon > /opt/gnomeos-harness/ponytail-libraries.txt \
    && ! grep -q 'not found' /opt/gnomeos-harness/ponytail-libraries.txt
LABEL org.opencontainers.image.description="Official GNOME OS plus native desktop test tools; not a stock GNOME OS image"
