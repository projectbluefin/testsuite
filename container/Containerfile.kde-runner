# KDE/Plasma e2e test runner image (host-side orchestration only).
#
# Published to: ghcr.io/projectbluefin/testsuite-kde-runner:kde-runner
#
# Used by the KDE e2e workflow to run behave + selenium/websocket-client on
# the orchestration host.  The suite drives the device-under-test over SSH
# (tests/shared/ssh_steps.py shells out to the `ssh` binary), so an SSH client
# (openssh-clients) is mandatory.  git is included for CI checkout/version
# operations, matching the lab-runner image.
#
# It deliberately does NOT ship selenium-webdriver-at-spi-inputsynth; that
# binary is a Qt6 Wayland client that must be built for each device-under-test
# to match its Plasma/Qt/KWin ABI.
#
# It also does NOT ship virtctl — that is a lab/KubeVirt concern handled by the
# lab-runner image and is not used by the GitHub Actions path.
#
# Triggered by: .github/workflows/build-kde-runner.yml

FROM registry.fedoraproject.org/fedora-minimal:latest@sha256:1f4d147e7787705a2a93d74de0772aef86866d19c1b40982573c23bede20fce2

LABEL org.opencontainers.image.source="https://github.com/projectbluefin/testsuite"
LABEL org.opencontainers.image.description="Host-side behave/selenium test runner for KDE/Plasma e2e tests"

RUN microdnf install -y --setopt=install_weak_deps=0 \
        python3 \
        python3-pip \
        openssh-clients \
        git \
    && microdnf clean all

WORKDIR /runner
COPY container/requirements.kde-runner.txt /runner/requirements.kde-runner.txt

# Install pinned Python stack.  No network fetch happens at test time.
RUN python3 -m pip install --no-cache-dir -r /runner/requirements.kde-runner.txt \
    && python3 -m pip cache purge

# Fail the build if any expected import is missing.
RUN python3 - <<'PY'
import behave, selenium, websocket, lxml, yaml
print("KDE runner Python stack OK")
PY

# Fail the build if required OS-level binaries are missing.
# ssh is mandatory — tests/shared/ssh_steps.py shells out to it.
# git is needed for CI checkout and version operations.
RUN command -v ssh && command -v git \
    && echo "OS tooling check OK: ssh and git present"
