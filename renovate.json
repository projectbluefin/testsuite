{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>projectbluefin/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Immutable-ref housekeeping automerges when CI passes; code-changing updates (digest, patch, minor) require human review under the supply-chain gate",
      "matchUpdateTypes": ["pin", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "KDE runner image and Python requirements",
      "matchFileNames": [
        "container/Containerfile.kde-runner",
        "container/requirements.kde-runner.txt"
      ],
      "addLabels": ["kde", "runner"]
    }
  ]
}
